/* ── content ── */
.content{padding:14px 20px 18px}

/* ── section ── */
.section{margin-bottom:10px;border:1px solid rgba(201,162,74,.22);border-radius:4px;overflow:hidden}
.sec-head{
    background:#1a1410;color:#c9a24a;
    font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;
    padding:5px 10px;
}

/* ── two-column data grid ── */
.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0;
}
.cell{
    display:flex;flex-direction:column;
    padding:5px 10px;
    border-bottom:1px solid rgba(201,162,74,.12);
    border-right:1px solid rgba(201,162,74,.12);
}
.cell:nth-child(even){border-right:none}
.cell.full{
    grid-column:1/-1;
    border-right:none;
}
.cell:last-child,.cell:nth-last-child(2):nth-child(odd){border-bottom:none}
.lbl{
    font-size:9px;letter-spacing:.08em;text-transform:uppercase;
    color:#9a8a6e;font-weight:600;margin-bottom:2px;
}
.val{font-size:11.5px;color:#1a1410;line-height:1.4}

/* ── scores row ── */
.scores{
    display:flex;flex-wrap:wrap;gap:6px;padding:8px 10px;
}
.score-chip{
    display:flex;flex-direction:column;align-items:center;
    background:#fffaf0;border:1px solid rgba(201,162,74,.3);
    border-radius:4px;padding:5px 10px;min-width:70px;
}
.score-chip .s-lbl{font-size:9px;color:#9a8a6e;letter-spacing:.06em;text-transform:uppercase;margin-bottom:3px}
.score-chip .s-val{font-size:16px;font-weight:700;color:#c9a24a;font-family:Georgia,serif}

/* ── error ── */
.err{padding:40px;text-align:center}
.err h2{font-size:20px;margin-bottom:10px;color:#1a1410}
.err p{color:#7a6a4e;font-size:13px;line-height:1.7}

/* ── footer ── */
.foot{
    border-top:1px solid rgba(201,162,74,.2);
    background:#fffaf0;
    padding:8px 20px;
    font-size:9.5px;color:#9a8a6e;line-height:1.5;
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;
}
.foot strong{color:#6b5c40}

/* ── print ── */
@media print{
    @page{margin:.45in .4in;size:letter portrait}
    body{background:#fff;padding:0;font-size:10.5px}
    .page{box-shadow:none;border:none;border-radius:0;max-width:100%}
    .toolbar{display:none}
    .hd{background:#fff!important;border-bottom:2px solid #000;padding:10px 14px}
    .hd h1{color:#000!important;font-size:16px}
    .hd-eye{color:#555!important}
    .hd-meta span{color:#555!important}
    .hd-meta strong{color:#000!important}
    .sec-head{background:#ddd!important;color:#000!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .section{border-color:#bbb;margin-bottom:7px}
    .cell{padding:4px 8px}
    .lbl{color:#555!important}
    .val{color:#000!important}
    .scores{padding:6px 8px;gap:4px}
    .score-chip{background:#f5f5f5!important;border-color:#bbb!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .score-chip .s-lbl{color:#555!important}
    .score-chip .s-val{color:#333!important;font-size:14px}
    .foot{background:#f5f5f5!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .content{padding:10px 14px 12px}
}
</style>
</head>
