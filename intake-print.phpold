<?php

$appointmentId = $_GET['appointmentId'] ?? '';

function loadEnvFile() {
    $envPath = __DIR__ . '/.env';
    if (!file_exists($envPath)) throw new Exception('.env file not found.');
    $envLines = file($envPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($envLines as $line) {
        $line = trim($line);
        if ($line === '' || strpos($line, '#') === 0) continue;
        [$key, $value] = array_pad(explode('=', $line, 2), 2, null);
        if ($key && $value !== null) $_ENV[trim($key)] = trim($value);
    }
}

function createPDOConnection() {
    loadEnvFile();
    $host = $_ENV['DB_HOST'] ?? 'localhost';
    $db   = $_ENV['DB_NAME'] ?? '';
    $user = $_ENV['DB_USERNAME'] ?? '';
    $pass = $_ENV['DB_PASSWORD'] ?? '';
    if (!$db || !$user) throw new Exception('Database credentials are missing.');
    $dsn = "mysql:host={$host};dbname={$db};charset=utf8mb4";
    return new PDO($dsn, $user, $pass, [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
}

function safeText($value) {
    if (is_array($value)) $value = implode(', ', array_filter($value));
    return htmlspecialchars(trim((string) $value), ENT_QUOTES, 'UTF-8');
}

function val($payload, $key) {
    $v = $payload[$key] ?? '';
    if (is_array($v)) $v = implode(', ', array_filter($v));
    $v = trim((string) $v);
    return $v !== '' ? safeText($v) : null;
}

$submission = null;
$payload    = [];
$error      = null;

try {
    if (empty($appointmentId)) throw new Exception('Missing appointment ID.');
    $pdo  = createPDOConnection();
    $stmt = $pdo->prepare("
        SELECT * FROM readiness_intake_submissions
        WHERE JSON_UNQUOTE(JSON_EXTRACT(raw_payload, '$.appointmentId')) = :appointment_id
        ORDER BY id DESC LIMIT 1
    ");
    $stmt->execute([':appointment_id' => $appointmentId]);
    $submission = $stmt->fetch();
    if (!$submission) throw new Exception('No submitted intake form found for this appointment ID.');
    $payload = json_decode($submission['raw_payload'] ?? '{}', true);
    if (!is_array($payload)) $payload = [];
} catch (Exception $e) {
    $error = $e->getMessage();
}

/* ── helper: render a two-column section grid ─────────────────────────────── */
function section(string $title, array $fields, array $payload, bool $fullWidth = false): string {
    $rows = '';
    foreach ($fields as $label => $key) {
        $v = val($payload, $key);
        if ($v === null) continue;
        $fw = $fullWidth ? ' full' : '';
        $rows .= "<div class='cell{$fw}'><span class='lbl'>" . safeText($label) . "</span><span class='val'>{$v}</span></div>";
    }
    if ($rows === '') return '';
    return "<div class='section'><div class='sec-head'>" . safeText($title) . "</div><div class='grid'>{$rows}</div></div>";
}
?>
