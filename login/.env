# Time zone for the back office: calendar, bookings and schedule settings.
# America/New_York is US Eastern: EST (UTC-5) in winter, EDT (UTC-4) in summer.
# For UTC-5 all year use America/Panama. Names like "EST" or "-05:00" are not accepted by the server.
# Keep this the same as PHELON_BOOKING_TIMEZONE in the backend. This value is public: no secrets in this file.
VITE_BOOKING_TIMEZONE=America/New_York

# TEMPORARY, until the server sends a role: accounts with these display names (comma separated)
# are shown as Admin. This only changes the badge and menus; it grants nothing on the server.
# Once /api/session returns "role", this setting is ignored and can be removed.
VITE_ADMIN_NAMES=Phelon Admin
